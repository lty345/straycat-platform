# =============================================================================
# deploy/.env —— 部署参数（不要提交到 git！）
# =============================================================================
# 复制成 deploy/.env 后填值：cp deploy/.env.example deploy/.env
# =============================================================================

# ---------------------------------------------------------------
# 【空 1】对外端口：浏览器访问 http://服务器IP:这个端口
#   建议 8080（80 已被机器上其它服务占用）
# ---------------------------------------------------------------
HOST_PORT=

# ---------------------------------------------------------------
# 【空 2】MySQL root 密码：自己定，字母数字组合，别太短
#   注意：这个密码同时给 db 和 api 用，写一次两处生效
# ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=

# ---- 下面不用改 ----
MYSQL_DATABASE=straycat
# 允许跨域的前端来源（逗号分隔）。注意不能写 *：
# 后端开了 allow_credentials，浏览器会拒绝 "Access-Control-Allow-Origin: *"
# 换成域名后把新来源加在这里
CORS_ALLOW_ORIGINS=http://8.134.196.108:8080
SECRET_KEY=change-me-in-production
